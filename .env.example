# Supabase CLI reads this file for local Auth SMTP settings.
# Use a Gmail app password, not your regular Gmail password.
GMAIL_SMTP_USER=your_gmail_address
GMAIL_SMTP_PASS=your_gmail_app_password
GMAIL_SMTP_ADMIN_EMAIL=admin@example.com

# Supabase Edge Function secrets for online suite payment.
# Set hosted secrets with: npx supabase secrets set PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PUBLIC_SITE_URL=http://localhost:3000
